{{ define "main" }}

<section class="research-page">

    <!-- =====================================================
         CABECERA DE INVESTIGACIÓN
         ===================================================== -->

    <div class="research-header">

        <div class="page-eyebrow">
            01 — Investigación
        </div>

        <h1 class="page-title">
            {{ .Title }}
        </h1>

        <div class="research-introduction">

            {{ .Content }}

        </div>

    </div>


    <!-- =====================================================
         PROGRAMA DE INVESTIGACIÓN
         ===================================================== -->

    <section class="research-program">

        <div class="program-label">
            Programa de investigación
        </div>

        <div class="program-content">

            <h2>
                Existir en el problema
            </h2>

            <p>
                Una investigación sobre las condiciones mediante las cuales algo llega a constituirse,
                persiste, se transforma y deja de ser lo que era.
            </p>

            <p>
                Las nueve líneas del programa pueden leerse como diferentes modos de abordar la
                <strong>génesis, orientación, estabilización y transformación de los problemas</strong>,
                así como las formas de existencia que emergen de sus resoluciones provisionales.
            </p>

            <a href="{{ "/programa-de-investigacion/" | relLangURL }}"
               class="program-action">

                <span>Explorar el programa</span>

                <span class="program-action-arrow" aria-hidden="true">
                    →
                </span>

            </a>

        </div>

    </section>


    <!-- =====================================================
         INVESTIGACIONES
         ===================================================== -->

    <section class="research-section">

        <div class="research-section-header">

            <div class="section-label">
                Investigaciones
            </div>

        </div>


        <div class="research-list">

            {{ range $index, $page := .Pages }}

            <a href="{{ $page.RelPermalink }}" class="research-card">

                <div class="research-number">
                    {{ printf "%02d" (add $index 1) }}
                </div>

                <div class="research-main">

                    <h2>
                        {{ $page.Title }}
                    </h2>

                    {{ with $page.Description }}

                    <p>
                        {{ . }}
                    </p>

                    {{ end }}

                </div>

                <div class="research-arrow" aria-hidden="true">
                    →
                </div>

            </a>

            {{ end }}

        </div>

    </section>

</section>


<style>

/* =========================================================
   PÁGINA DE INVESTIGACIÓN
   ========================================================= */

.research-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 110px 5vw 140px;
}


/* =========================================================
   CABECERA
   ========================================================= */

.research-header {
    margin-bottom: 0;
}

.research-header .page-eyebrow {
    margin-bottom: 35px;
}

.research-header .page-title {
    max-width: 1000px;
    margin: 0 0 55px;
}


/* =========================================================
   INTRODUCCIÓN
   ========================================================= */

.research-introduction {
    max-width: 760px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.85;
    text-align: justify;
}

.research-introduction p {
    margin: 0 0 26px;
}

.research-introduction strong {
    color: var(--foreground);
    font-weight: 400;
}


/* =========================================================
   PROGRAMA DE INVESTIGACIÓN
   ========================================================= */

.research-program {
    margin-top: 110px;
    padding-top: 55px;
    padding-bottom: 90px;
    border-top: 1px solid var(--line);
}

.program-label {
    margin-bottom: 30px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.program-content {
    max-width: 760px;
}

.program-content h2 {
    margin: 0 0 28px;
    color: var(--foreground);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 54px;
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -1px;
}

.program-content p {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.85;
    text-align: justify;
}

.program-content strong {
    color: var(--foreground);
    font-weight: 400;
}


/* =========================================================
   ENLACE AL PROGRAMA
   ========================================================= */

.program-action {
    display: inline-flex;
    align-items: center;
    gap: 24px;

    margin-top: 30px;
    padding-bottom: 8px;

    border-bottom: 1px solid var(--line);

    color: var(--foreground);

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;

    transition:
        color 0.2s ease,
        border-color 0.2s ease;
}

.program-action:hover {
    color: var(--accent);
    border-color: var(--accent);
}

.program-action-arrow {
    position: static;
    font-size: 21px;
    line-height: 1;
    transition: transform 0.2s ease;
}

.program-action:hover .program-action-arrow {
    transform: translateX(5px);
}


/* =========================================================
   SECCIÓN INVESTIGACIONES
   ========================================================= */

.research-section {
    margin-top: 0;
}

.research-section-header {
    margin-bottom: 0;
}

.section-label {
    padding-bottom: 22px;

    border-bottom: 1px solid var(--line);

    color: var(--foreground);

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
}


/* =========================================================
   LISTADO
   ========================================================= */

.research-list {
    border-top: none;
}

.research-card {
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    align-items: center;

    gap: 30px;

    padding: 42px 20px;

    border-bottom: 1px solid var(--line);

    color: inherit;

    transition:
        background 0.25s ease,
        padding 0.25s ease;
}

.research-card:hover {
    background: #11110F;
    padding-left: 30px;
    padding-right: 30px;
}

.research-number {
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

.research-main {
    min-width: 0;
}

.research-main h2 {
    display: inline-block;

    margin: 0 0 12px;

    padding-bottom: 5px;

    border-bottom: 1px solid transparent;

    color: var(--foreground);

    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.5px;

    transition:
        color 0.2s ease,
        border-color 0.2s ease;
}

.research-card:hover .research-main h2 {
    color: var(--foreground);
    border-color: var(--accent);
}

.research-main p {
    max-width: 680px;

    margin: 0;

    color: var(--muted);

    font-size: 15px;
    line-height: 1.7;

    text-align: justify;
}

.research-arrow {
    color: var(--muted);
    font-size: 23px;
    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

.research-card:hover .research-arrow {
    color: var(--accent);
    transform: translateX(5px);
}


/* =========================================================
   MÓVIL
   ========================================================= */

@media (max-width: 700px) {

    .research-page {
        padding-top: 80px;
        padding-bottom: 90px;
    }

    .research-header .page-title {
        margin-bottom: 40px;
    }

    .research-introduction {
        font-size: 16px;
        line-height: 1.8;
        text-align: justify;
    }

    .research-program {
        margin-top: 75px;
        padding-top: 40px;
        padding-bottom: 70px;
    }

    .program-label {
        margin-bottom: 24px;
    }

    .program-content h2 {
        font-size: 43px;
        line-height: 1.05;
    }

    .program-content p {
        font-size: 16px;
        line-height: 1.8;
        text-align: justify;
    }

    .program-action {
        gap: 18px;
        margin-top: 25px;
    }

    .section-label {
        padding-bottom: 18px;
    }

    .research-card {
        grid-template-columns: 42px 1fr 24px;
        gap: 15px;
        padding: 30px 8px;
    }

    .research-card:hover {
        padding-left: 12px;
        padding-right: 12px;
    }

    .research-main h2 {
        font-size: 28px;
    }

    .research-main p {
        font-size: 14px;
        line-height: 1.65;
        text-align: justify;
    }

}

</style>

{{ end }}
