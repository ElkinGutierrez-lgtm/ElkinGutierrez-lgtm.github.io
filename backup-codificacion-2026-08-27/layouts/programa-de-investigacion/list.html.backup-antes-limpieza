{{ define "main" }}

<section class="research-page">

    <header class="research-header">

        <div class="page-eyebrow">
            01 — Investigación
        </div>

        <h1 class="page-title">
            {{ .Title }}
        </h1>

    </header>


    <article class="research-content">

        {{ .Content }}

    </article>

</section>


<style>

.research-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 110px 5vw 140px;
}


/* =========================================================
   CABECERA
   ========================================================= */

.research-header {
    margin-bottom: 65px;
}

.research-header .page-eyebrow {
    margin-bottom: 35px;
}

.research-header .page-title {
    max-width: 1000px;
    margin: 0;
}


/* =========================================================
   CONTENIDO
   ========================================================= */

.research-content {
    max-width: 760px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.85;
    text-align: justify;
}


/* =========================================================
   INTRODUCCIÓN
   ========================================================= */

.research-content h2 {
    margin: 0 0 28px;

    color: var(--foreground);

    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 54px;
    line-height: 1.05;
    font-weight: 500;

    letter-spacing: -1px;
}


/* =========================================================
   PÁRRAFOS
   ========================================================= */

.research-content p {
    margin: 0 0 28px;
}

.research-content strong {
    color: var(--foreground);
    font-weight: 400;
}


/* =========================================================
   NUEVE ÁREAS DE INVESTIGACIÓN
   ========================================================= */

.research-content h3 {
    position: relative;

    margin-top: 75px;
    margin-bottom: 24px;
    padding-bottom: 12px;

    color: var(--foreground);

    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 34px;
    line-height: 1.15;
    font-weight: 500;

    letter-spacing: -0.5px;

    border-bottom: 1px solid var(--line);
}


/* Subrayado editorial */

.research-content h3::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -1px;

    width: 58px;
    height: 2px;

    background: var(--accent);
}


/* =========================================================
   LISTA / OTROS ELEMENTOS
   ========================================================= */

.research-content ul {
    padding-left: 25px;
}

.research-content li {
    margin-bottom: 10px;
}


/* =========================================================
   MÓVIL
   ========================================================= */

@media (max-width: 700px) {

    .research-page {
        padding-top: 80px;
        padding-bottom: 90px;
    }

    .research-header {
        margin-bottom: 45px;
    }

    .research-content {
        font-size: 16px;
        line-height: 1.8;
        text-align: justify;
    }

    .research-content h2 {
        font-size: 43px;
        line-height: 1.05;
    }

    .research-content h3 {
        margin-top: 60px;
        margin-bottom: 20px;

        font-size: 28px;
    }

}

</style>

{{ end }}
