        border-color 0.25s ease,
        color 0.25s ease,
        transform 0.25s ease;

}


.theme-toggle:hover {

    background: var(--line);
    border-color: var(--muted);

    transform: rotate(8deg);

}


.theme-toggle:focus-visible {

    outline: 2px solid var(--accent);
    outline-offset: 3px;

}


.theme-toggle-icon {

    position: relative;

    display: block;

    width: 18px;
