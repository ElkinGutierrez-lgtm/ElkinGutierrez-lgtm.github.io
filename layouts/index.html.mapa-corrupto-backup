/* =========================================
   THEME SWITCH
   ========================================= */

html[data-theme="light"] {

    --background: #F4F1EA;
    --foreground: #171614;
    --muted: #68645D;
    --line: #D8D3C8;
    --accent: #7A2638;

}


/* =========================================
   THEME TOGGLE BUTTON
   ========================================= */

.theme-toggle {

    appearance: none;
    -webkit-appearance: none;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    padding: 0;
    margin: 0;

    border: 1px solid var(--line);
    border-radius: 50%;

    background: transparent;
    color: var(--foreground);

    cursor: pointer;

    flex: 0 0 auto;

    transition:
        background-color 0.25s ease,
        border-color 0.25s ease,
        color 0.25s ease,
        transform 0.25s ease;

}


.theme-toggle:hover {

    background: var(--line);
    border-color: var(--muted);

    transform: rotate(8deg);

}


.theme-toggle:focus-visible {

    outline: 2px solid var(--accent);
    outline-offset: 3px;

}


.theme-toggle-icon {

    position: relative;

    display: block;

    width: 18px;
    height: 18px;

}


/* LUNA */

.theme-toggle-icon::before {

    content: "☾";

    position: absolute;

    inset: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 18px;
    line-height: 1;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}


/* SOL */

html[data-theme="light"] .theme-toggle-icon::before {

    content: "☀";

}


/* =========================================
   THEME TRANSITION
   ========================================= */

html[data-theme="light"],
html[data-theme="light"] body,
html[data-theme="light"] .site-header,
html[data-theme="light"] footer {

    transition:
        background-color 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease;

}


/* =========================================
   INITIAL THEME
   ========================================= */

html {

    background: var(--background);

}

